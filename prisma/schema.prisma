generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LocationStatus {
  OPEN
  CLOSED
  UNKNOWN
}

enum KeywordSource {
  GBP_SUGGESTED
  MANUAL
}

enum KeywordState {
  SUGGESTED
  APPROVED
  PAUSED
}

enum ScanStatus {
  QUEUED
  SUBMITTING
  RUNNING
  COMPLETE
  PARTIAL
  FAILED
}

enum PointStatus {
  PENDING
  SUBMITTED
  COMPLETE
  RETRYABLE_FAILED
  PERMANENT_FAILED
}

enum RequestOrigin {
  MANUAL
  SCHEDULED
  RETRY
}

model GoogleConnection {
  id                    String   @id @default(cuid())
  accountEmail          String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  scope                 String?
  tokenExpiresAt        DateTime?
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
model CachedReport {
  id String @id @default(cuid())
  cacheKey String @unique
  reportType String
  propertyId String?
  parametersJson String
  payloadJson String
  fetchedAt DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([reportType, propertyId])
}
model OAuthState {
  stateHash String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model BusinessLocation {
  id                 String              @id @default(cuid())
  googleLocationId   String              @unique
  googleAccountId    String
  title              String
  address            String?
  latitude           Float?
  longitude          Float?
  primaryCategory    String?
  status             LocationStatus      @default(UNKNOWN)
  isTrackingActive   Boolean             @default(false)
  lastSynchronizedAt DateTime
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  keywords           TrackedKeyword[]
  analyticsCache     GbpAnalyticsCache[]
  scans              GeoGridScan[]

  @@index([googleAccountId])
  @@index([title])
}

model TrackedKeyword {
  id                 String           @id @default(cuid())
  businessLocationId String
  displayKeyword     String
  normalizedKeyword  String
  source             KeywordSource
  state              KeywordState     @default(SUGGESTED)
  defaultGridSize    Int              @default(7)
  radiusKm           Float            @default(2)
  languageCode       String           @default("en")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  businessLocation   BusinessLocation @relation(fields: [businessLocationId], references: [id], onDelete: Cascade)
  scans              GeoGridScan[]

  @@unique([businessLocationId, normalizedKeyword])
  @@index([businessLocationId, state])
}

model GeoGridScan {
  id                 String           @id @default(cuid())
  businessLocationId String
  trackedKeywordId   String
  fingerprint        String           @unique
  keyword            String
  centerLatitude     Float
  centerLongitude    Float
  gridSize           Int
  radiusKm           Float
  languageCode       String
  providerMethod     String
  origin             RequestOrigin
  status             ScanStatus       @default(QUEUED)
  pointCount         Int
  completedCount     Int              @default(0)
  failedCount        Int              @default(0)
  estimatedCostUsd   Decimal          @db.Decimal(12, 6)
  actualCostUsd      Decimal          @default(0) @db.Decimal(12, 6)
  failureCode        String?
  createdAt          DateTime         @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  updatedAt          DateTime         @updatedAt
  businessLocation   BusinessLocation @relation(fields: [businessLocationId], references: [id], onDelete: Restrict)
  trackedKeyword     TrackedKeyword   @relation(fields: [trackedKeywordId], references: [id], onDelete: Restrict)
  points             GeoGridPoint[]
  spend              ProviderSpend[]

  @@index([status, createdAt])
  @@index([businessLocationId, trackedKeywordId, createdAt])
}

model GeoGridPoint {
  id             String              @id @default(cuid())
  scanId         String
  row            Int
  column         Int
  latitude       Float
  longitude      Float
  status         PointStatus         @default(PENDING)
  providerTaskId String?             @unique
  targetRank     Int?
  targetPlaceId  String?
  matchConfidence String?
  costUsd        Decimal             @default(0) @db.Decimal(12, 6)
  failureCode    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  scan           GeoGridScan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  competitors    GeoGridCompetitor[]

  @@unique([scanId, row, column])
  @@index([scanId, status])
}

model GeoGridCompetitor {
  id         String       @id @default(cuid())
  pointId    String
  placeId    String?
  name       String
  rank       Int
  address    String?
  point      GeoGridPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@index([pointId, rank])
}

model ProviderSpend {
  id        String       @id @default(cuid())
  scanId    String?
  amountUsd Decimal      @db.Decimal(12, 6)
  incurredAt DateTime    @default(now())
  scan      GeoGridScan? @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@index([incurredAt])
}

model GbpAnalyticsCache {
  id                 String           @id @default(cuid())
  businessLocationId String
  reportType         String
  startDate          DateTime
  endDate            DateTime
  payloadJson        String
  fetchedAt          DateTime
  expiresAt          DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  businessLocation   BusinessLocation @relation(fields: [businessLocationId], references: [id], onDelete: Cascade)

  @@unique([businessLocationId, reportType, startDate, endDate])
  @@index([expiresAt])
}
